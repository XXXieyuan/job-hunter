<% layout('layout') -%>

<section class="error-page">
  <div class="error-card glass-card">
    <h1 class="error-code">
      <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
    </h1>
    <h2 class="error-title">
      <%= typeof t === 'function' ? t('errors.500.title', 'Something Went Wrong') : 'Something Went Wrong' %>
    </h2>
    <p class="error-body text-secondary">
      <%= typeof t === 'function' ? t('errors.500.body', 'An internal error occurred. Please try again later.') : 'An internal error occurred. Please try again later.' %>
    </p>
    <a href="/jobs" class="btn btn-primary">
      <%= typeof t === 'function' ? t('errors.backToJobs', 'Back to Job Listings') : 'Back to Job Listings' %>
    </a>
  </div>
</section>
