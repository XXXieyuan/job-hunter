<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' && locale === 'zh' ? 'zh-CN' : 'en' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof t === 'function' ? t('app.fullTitle') : 'Job Hunter' %></title>
    <meta name="description" content="AI-powered job matching across Seek, LinkedIn, and APSJobs" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <% } %>
  </head>
  <body>
    <div class="app-root">
      <%- include('partials/nav') %>

      <!-- Shared SVG defs for score indicator gradients -->
      <svg class="visually-hidden" aria-hidden="true" focusable="false" width="0" height="0">
        <defs>
          <linearGradient id="score-gradient-excellent" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#059669" />
            <stop offset="100%" stop-color="#10B981" />
          </linearGradient>
          <linearGradient id="score-gradient-good" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0891B2" />
            <stop offset="100%" stop-color="#06B6D4" />
          </linearGradient>
          <linearGradient id="score-gradient-fair" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#D97706" />
            <stop offset="100%" stop-color="#F59E0B" />
          </linearGradient>
          <linearGradient id="score-gradient-low" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#DC2626" />
            <stop offset="100%" stop-color="#EF4444" />
          </linearGradient>
        </defs>
      </svg>

      <main class="app-main">
        <%- body %>
      </main>

      <%- include('partials/footer') %>

      <%- include('partials/toast') %>

      <% if (typeof user !== 'undefined' && user) { %>
        <%- include('partials/onboarding') %>
      <% } %>
    </div>

    <script src="/js/main.js"></script>
    <script src="/js/components.js"></script>
    <% if (typeof user !== 'undefined' && user) { %>
    <script src="/js/onboarding.js"></script>
    <% } %>
    <% if (typeof currentPath !== 'undefined' && currentPath && currentPath.startsWith('/admin')) { %>
    <script src="/js/admin.js"></script>
    <% } %>
  </body>
</html>
