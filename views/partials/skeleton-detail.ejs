<%
  /**
   * SkeletonLoader - Detail variant
   * Matches job detail page layout geometry
   */
%>
<div aria-hidden="true" role="presentation">
  <!-- Back link placeholder -->
  <div class="skeleton" style="width: 100px; height: 14px; margin-bottom: 16px; border-radius: 6px;"></div>

  <!-- Title area -->
  <div class="skeleton skeleton-title" style="width: 60%; height: 28px; margin-bottom: 8px;"></div>
  <div class="skeleton skeleton-text" style="width: 40%; margin-bottom: 24px;"></div>

  <!-- Tab bar placeholder -->
  <div class="skeleton" style="width: 100%; height: 40px; border-radius: 10px; margin-bottom: 20px;"></div>

  <!-- Two-column layout -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
    <div>
      <div class="skeleton skeleton-text" style="width: 100%;"></div>
      <div class="skeleton skeleton-text" style="width: 100%;"></div>
      <div class="skeleton skeleton-text" style="width: 95%;"></div>
      <div class="skeleton skeleton-text" style="width: 100%;"></div>
      <div class="skeleton skeleton-text--medium" style="width: 85%;"></div>
      <div class="skeleton skeleton-text" style="width: 100%;"></div>
      <div class="skeleton skeleton-text" style="width: 90%;"></div>
      <div class="skeleton skeleton-text--short" style="width: 70%;"></div>
    </div>
    <div>
      <div class="skeleton skeleton-circle" style="width: 80px; height: 80px; margin: 0 auto 16px;"></div>
      <div class="skeleton skeleton-text" style="width: 80%; margin: 0 auto 8px;"></div>
      <div class="skeleton skeleton-text--short" style="width: 60%; margin: 0 auto 16px;"></div>
      <div class="skeleton" style="width: 100%; height: 120px; border-radius: 10px;"></div>
    </div>
  </div>
</div>
