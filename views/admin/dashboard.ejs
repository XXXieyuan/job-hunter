<% layout('layout') -%>

<section class="page-section admin-section" id="admin-root" style="max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px;">
  <div class="section-header admin-header">
    <h1>Admin Dashboard</h1>
    <p class="section-subtitle">Manage scrapers, analysis, job data, and system health.</p>
  </div>

  <% var _isAdmin = typeof isAdmin !== 'undefined' ? isAdmin : true; %>
  <% if (!_isAdmin) { %>
  <!-- Inline admin token form (shown when jh_admin_session absent) -->
  <div style="max-width: 400px; margin: 48px auto; background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 32px;">
    <h2 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; text-align: center;">Admin Authentication</h2>
    <p style="font-size: 13px; color: var(--text-secondary, #4B5563); margin-bottom: 20px; text-align: center;">Enter the admin token to access the dashboard.</p>
    <form id="admin-login-form" style="display: flex; flex-direction: column; gap: 12px;">
      <input type="password" id="admin-token-input" class="input" placeholder="Admin token"
             style="width: 100%; padding: 10px 12px; font-size: 14px;" autocomplete="off" required />
      <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
      <p id="admin-login-error" style="font-size: 12px; color: #DC2626; text-align: center; display: none;"></p>
    </form>
  </div>
  <script>
  (function() {
    var form = document.getElementById('admin-login-form');
    var errorEl = document.getElementById('admin-login-error');
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var token = document.getElementById('admin-token-input').value;
      if (!token) return;
      errorEl.style.display = 'none';
      fetch('/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: token }),
        redirect: 'follow'
      })
      .then(function(res) {
        if (res.redirected) {
          window.location.href = res.url;
        } else if (!res.ok) {
          return res.json().then(function(data) {
            errorEl.textContent = (data.error && data.error.message) || 'Invalid token.';
            errorEl.style.display = 'block';
          });
        } else {
          window.location.reload();
        }
      })
      .catch(function() {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.style.display = 'block';
      });
    });
  })();
  </script>
  <% } else { %>

  <%
    var _jobCounts = typeof jobCounts !== 'undefined' ? jobCounts : { total: 0, withScore: 0 };
    var _fitStats = typeof fitStats !== 'undefined' ? fitStats : { total: 0, avg: 0 };
    var _sourceCounts = typeof sourceCounts !== 'undefined' ? sourceCounts : {};
    var _lastRun = typeof lastRun !== 'undefined' ? lastRun : null;
    var _scraperRuns = typeof scraperRuns !== 'undefined' ? scraperRuns : [];
    var _userCounts = typeof userCounts !== 'undefined' ? userCounts : { total: 0, with_resume: 0 };
    var _sourceFreshness = typeof sourceFreshness !== 'undefined' ? sourceFreshness : {};
    var _platformHealth = typeof platformHealth !== 'undefined' ? platformHealth : {};
    var _dbSizeMb = typeof dbSizeMb !== 'undefined' ? dbSizeMb : 0;
    var _coverLetterCount = typeof coverLetterCount !== 'undefined' ? coverLetterCount : 0;
  %>

  <!-- Stats Overview Panel -->
  <div class="admin-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px;">
    <div class="admin-stat-card" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 16px;">
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">Total Jobs</span>
      <span style="display: block; font-size: 24px; font-weight: 600; color: var(--text, #1A1D23);"><%= _jobCounts.total %></span>
      <div style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px;">
        <span class="tag tag-seek" style="font-size: 10px;">Seek: <%= _sourceCounts.seek || 0 %></span>
        <span class="tag tag-linkedin" style="font-size: 10px;">LinkedIn: <%= _sourceCounts.linkedin || 0 %></span>
        <span class="tag tag-apsjobs" style="font-size: 10px;">APS: <%= _sourceCounts.apsjobs || 0 %></span>
        <span class="tag tag-actgov" style="font-size: 10px;">ACT Gov: <%= _sourceCounts.actgov || 0 %></span>
        <span class="tag tag-nswgov" style="font-size: 10px;">NSW Gov: <%= _sourceCounts.nswgov || 0 %></span>
      </div>
    </div>
    <div class="admin-stat-card" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 16px;">
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">Users</span>
      <span style="display: block; font-size: 24px; font-weight: 600; color: var(--text, #1A1D23);"><%= _userCounts.total %></span>
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">With resume: <%= _userCounts.with_resume %></span>
    </div>
    <div class="admin-stat-card" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 16px;">
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">Scores / Cover Letters</span>
      <span style="display: block; font-size: 24px; font-weight: 600; color: var(--text, #1A1D23);"><%= _fitStats.total %> / <%= _coverLetterCount %></span>
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">Avg score: <%= typeof _fitStats.avg === 'number' ? _fitStats.avg.toFixed(1) : '0' %>%</span>
    </div>
    <div class="admin-stat-card" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 16px;">
      <span style="font-size: 12px; color: var(--text-muted, #6B7280);">Database Size</span>
      <span style="display: block; font-size: 24px; font-weight: 600; color: var(--text, #1A1D23);"><%= typeof _dbSizeMb === 'number' ? _dbSizeMb.toFixed(1) : '0' %> MB</span>
    </div>
  </div>

  <!-- Platform Health Panel -->
  <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
    <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Platform Health</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
      <% ['linkedin', 'seek', 'apsjobs', 'actgov'].forEach(function(src) {
        var health = _platformHealth[src] || {};
        var status = health.status || 'unknown';
        var statusColor = status === 'healthy' ? '#059669' : (status === 'warning' ? '#D97706' : '#DC2626');
        var statusBg = status === 'healthy' ? '#ecfdf5' : (status === 'warning' ? '#fffbeb' : '#fef2f2');
        var statusBorder = status === 'healthy' ? '#a7f3d0' : (status === 'warning' ? '#fde68a' : '#fecaca');
      %>
      <div style="border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 8px; padding: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
          <span style="width: 10px; height: 10px; border-radius: 50%; background: <%= statusColor %>;"></span>
          <span style="font-size: 14px; font-weight: 500; text-transform: capitalize;"><%= src %></span>
          <span style="padding: 2px 6px; font-size: 10px; border-radius: 4px; background: <%= statusBg %>; color: <%= statusColor %>; border: 1px solid <%= statusBorder %>;">
            <%= status %>
          </span>
        </div>
        <% if (health.last_success) { %>
          <div style="font-size: 11px; color: var(--text-muted, #6B7280);">Last success: <%= health.last_success %></div>
        <% } %>
        <% if (health.last_error) { %>
          <div style="font-size: 11px; color: var(--text-muted, #6B7280);">Last error: <%= health.last_error %></div>
        <% } %>
        <% if (typeof health.error_rate === 'number') { %>
          <div style="font-size: 11px; color: var(--text-muted, #6B7280);">Error rate: <%= (health.error_rate * 100).toFixed(1) %>%</div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <!-- Source Freshness -->
    <div style="margin-top: 12px; font-size: 12px; color: var(--text-muted, #6B7280);">
      <strong>Source freshness:</strong>
      <% ['linkedin', 'seek', 'apsjobs', 'actgov'].forEach(function(src) { %>
        <span style="margin-left: 12px;"><%= src %>: <%= _sourceFreshness[src] || 'never' %></span>
      <% }); %>
    </div>
  </div>

  <!-- Two-column grid for controls -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 20px; margin-bottom: 20px;">

    <!-- Scraper Controls -->
    <div class="admin-card" id="scraper-section" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;"
      data-i18n-triggering="Triggering scrape, please wait..."
      data-i18n-started-with-id="Scrape started, run ID: {runId}."
      data-i18n-started="Scrape started."
      data-i18n-empty-runs="No scraper runs yet."
      data-i18n-trigger-failed-prefix="Trigger failed: "
      data-i18n-network-error="Trigger failed: Network error or server unavailable."
      data-i18n-status-running="Running" data-i18n-status-queued="Queued"
      data-i18n-status-success="Success" data-i18n-status-failure="Failed"
      data-i18n-status-unknown="Unknown">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Scraper Control</h2>

      <div style="margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--text-muted, #6B7280); display: block; margin-bottom: 4px;">Platform</label>
        <div class="platform-selector" id="platform-selector" style="display: flex; gap: 4px; flex-wrap: wrap;">
          <button type="button" class="btn btn-ghost btn-sm platform-btn active" data-platform="apsjobs">APSJobs</button>
          <button type="button" class="btn btn-ghost btn-sm platform-btn" data-platform="seek">Seek</button>
          <button type="button" class="btn btn-ghost btn-sm platform-btn" data-platform="linkedin">LinkedIn</button>
          <button type="button" class="btn btn-ghost btn-sm platform-btn" data-platform="actgov">ACT Gov</button>
          <button type="button" class="btn btn-ghost btn-sm platform-btn" data-platform="nswgov">NSW Gov</button>
        </div>
      </div>

      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px;">
        <div style="flex: 1; min-width: 100px;">
          <label style="font-size: 11px; color: var(--text-muted, #6B7280);" for="scraper-keywords">Keywords</label>
          <input id="scraper-keywords" type="text" class="input" placeholder="e.g. Data,Engineer" style="width: 100%; padding: 6px 8px; font-size: 13px;" />
        </div>
        <div style="flex: 1; min-width: 100px;">
          <label style="font-size: 11px; color: var(--text-muted, #6B7280);" for="scraper-region">Region</label>
          <input id="scraper-region" type="text" class="input" placeholder="e.g. Canberra,ACT" style="width: 100%; padding: 6px 8px; font-size: 13px;" />
        </div>
        <div style="width: 80px;">
          <label style="font-size: 11px; color: var(--text-muted, #6B7280);" for="scraper-max-pages">Max Pages</label>
          <input id="scraper-max-pages" type="number" min="1" class="input" placeholder="3" style="width: 100%; padding: 6px 8px; font-size: 13px;" />
        </div>
      </div>

      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button id="trigger-scraper-btn" class="btn btn-primary btn-sm">Trigger Scrape (selected)</button>
        <button id="trigger-all-scrapers-btn" class="btn btn-secondary btn-sm">Scrape All Sources</button>
      </div>
      <p id="scraper-status" class="text-muted" style="font-size: 12px; margin-top: 8px;"></p>

      <!-- Recent Runs Table -->
      <h3 style="margin-top: 16px; font-size: 14px; font-weight: 500;">Recent Scraper Runs</h3>
      <div style="overflow-x: auto; margin-top: 8px;">
        <table class="table" id="scraper-runs-table" style="width: 100%; font-size: 12px;">
          <thead>
            <tr><th>ID</th><th>Scraper</th><th>Status</th><th>Started</th><th>Finished</th><th>Jobs</th><th>Error</th></tr>
          </thead>
          <tbody>
            <% if (!_scraperRuns || !_scraperRuns.length) { %>
            <tr><td colspan="7" style="color: var(--text-muted, #6B7280);">No scraper runs yet.</td></tr>
            <% } else { %>
            <% _scraperRuns.forEach(function(run) { %>
            <tr data-run-id="<%= run.id %>">
              <td><%= run.id %></td>
              <td><%= run.scraper_name %></td>
              <td>
                <% if (run.status === 'running' || run.status === 'queued') { %>
                <span style="color: #D97706; font-weight: 500;"><%= run.status %></span>
                <% } else if (run.status === 'success') { %>
                <span style="color: #059669; font-weight: 500;">Success</span>
                <% } else { %>
                <span style="color: #DC2626; font-weight: 500;">Failed</span>
                <% } %>
              </td>
              <td><%= run.started_at || '-' %></td>
              <td><%= run.finished_at || '-' %></td>
              <td><%= typeof run.jobs_added === 'number' ? run.jobs_added : '-' %></td>
              <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis;"><%= run.error_message || '-' %></td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Analysis Controls -->
    <div class="admin-card" id="analysis-section" style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;"
      data-i18n-triggering="Triggering analysis, please wait..."
      data-i18n-started-with-id="Analysis started, run ID: {runId}."
      data-i18n-started="Analysis started."
      data-i18n-trigger-failed-prefix="Trigger failed: "
      data-i18n-network-error="Trigger failed: Network error or server unavailable.">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">AI Analysis</h2>

      <div style="margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--text-muted, #6B7280); display: block; margin-bottom: 4px;">Analysis Type</label>
        <select id="analysis-type" style="padding: 6px 8px; border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 6px; font-size: 13px;">
          <option value="full">Full Analysis</option>
          <option value="scoring">Scoring Only</option>
          <option value="cover_letters">Cover Letters</option>
          <option value="company_research">Company Research</option>
          <option value="embeddings">Embeddings</option>
        </select>
      </div>

      <% if (_lastRun) { %>
      <div style="margin-bottom: 12px; padding: 8px 12px; background: var(--bg-subtle, #F1F3F5); border-radius: 8px; font-size: 12px;">
        <span>Last run ID: <strong><%= _lastRun.id %></strong></span>
        <% if (_lastRun.status === 'running') { %>
        <span style="color: #D97706; font-weight: 500; margin-left: 8px;">Running</span>
        <% } else if (_lastRun.status === 'completed') { %>
        <span style="color: #059669; font-weight: 500; margin-left: 8px;">Completed</span>
        <% } else { %>
        <span style="color: #DC2626; font-weight: 500; margin-left: 8px;">Failed</span>
        <% } %>
        <% if (_lastRun.error) { %>
        <div style="color: #DC2626; margin-top: 4px;">Error: <%= _lastRun.error %></div>
        <% } %>
      </div>
      <% } %>

      <button id="run-analysis-btn" class="btn btn-primary btn-sm">Run Analysis</button>
      <p id="run-analysis-status" class="text-muted" style="font-size: 12px; margin-top: 8px;"></p>

      <!-- Analysis Runs History Table -->
      <h3 style="margin-top: 16px; font-size: 14px; font-weight: 500;">Recent Analysis Runs</h3>
      <div style="overflow-x: auto; margin-top: 8px;">
        <table class="table" id="analysis-runs-table" style="width: 100%; font-size: 12px;">
          <thead>
            <tr><th>ID</th><th>Type</th><th>Status</th><th>Started</th><th>Finished</th><th>Processed</th><th>Error</th></tr>
          </thead>
          <tbody id="analysis-runs-tbody">
            <tr><td colspan="7" style="color: var(--text-muted, #6B7280);">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" id="refresh-analysis-runs-btn" style="margin-top: 4px;">Refresh</button>

      <!-- Queue Status -->
      <div id="queue-status-panel" style="margin-top: 16px; padding: 12px; background: var(--bg-subtle, #F1F3F5); border-radius: 8px;">
        <h3 style="font-size: 14px; font-weight: 500; margin-bottom: 8px;">Queue Status</h3>
        <div id="queue-status-content" style="font-size: 12px; color: var(--text-secondary, #4B5563);">
          Loading...
        </div>
      </div>
    </div>
  </div>

  <!-- Error Log Viewer -->
  <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
    <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Error Log</h2>
    <div id="error-log-container" style="max-height: 400px; overflow-y: auto;">
      <p style="font-size: 12px; color: var(--text-muted, #6B7280);">Loading errors...</p>
    </div>
    <button type="button" class="btn btn-ghost btn-sm" id="refresh-errors-btn" style="margin-top: 8px;">Refresh</button>
  </div>

  <!-- Bottom row: Cleanup + Upload + Dedup -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 20px;">

    <!-- Data Cleanup -->
    <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Data Maintenance</h2>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <button type="button" class="btn btn-ghost btn-sm cleanup-btn" data-type="raw_json">Clean Raw JSON (&gt;30 days)</button>
        <button type="button" class="btn btn-ghost btn-sm cleanup-btn" data-type="inactive">Archive Inactive Jobs (&gt;90 days)</button>
        <button type="button" class="btn btn-ghost btn-sm cleanup-btn" data-type="sessions">Clean Expired Sessions</button>
        <button type="button" class="btn btn-ghost btn-sm cleanup-btn" data-type="all" style="font-weight: 500;">Run All Cleanup</button>
      </div>
      <p id="cleanup-status" style="font-size: 12px; color: var(--text-muted, #6B7280); margin-top: 8px;"></p>
    </div>

    <!-- Upload Job Data -->
    <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Upload Job Data</h2>
      <p style="font-size: 12px; color: var(--text-secondary, #4B5563); margin-bottom: 12px;">
        Accepts JSON: array of job objects with title, company_name, description, url, location, salary.
      </p>
      <form id="upload-form">
        <textarea id="upload-json" rows="5" class="input" placeholder='[{"title":"Senior AI Engineer",...}]'
                  style="width: 100%; padding: 8px; font-size: 12px;"></textarea>
        <button type="submit" class="btn btn-ghost btn-sm" style="margin-top: 8px;">Upload JSON</button>
      </form>
      <p id="upload-status" style="font-size: 12px; color: var(--text-muted, #6B7280); margin-top: 8px;"></p>

      <div style="border-top: 1px solid var(--border-subtle, #E2E6EA); margin-top: 12px; padding-top: 12px;">
        <h3 style="font-size: 13px; font-weight: 500; margin-bottom: 8px;">Upload via File</h3>
        <form id="upload-file-form" action="/admin/jobs/upload" method="POST" enctype="multipart/form-data">
          <input type="file" name="jobFile" accept="application/json" />
          <button type="submit" class="btn btn-ghost btn-sm" style="margin-top: 8px;">Upload JSON File</button>
        </form>
      </div>
    </div>

    <!-- Company Research Panel (T-G.1) -->
    <%
      var _totalCompanies = typeof totalCompanies !== 'undefined' ? totalCompanies : 0;
      var _unresearchedCount = typeof unresearchedCount !== 'undefined' ? unresearchedCount : 0;
      var _researchedCount = _totalCompanies - _unresearchedCount;
    %>
    <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;">
      <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">Company Research</h3>
      <p style="font-size: 13px; color: var(--text-secondary, #4B5563); margin-bottom: 12px;">
        <%= _researchedCount %> of <%= _totalCompanies %> companies researched
      </p>
      <% if (_unresearchedCount > 0) { %>
        <form method="POST" action="/admin/company-research/run">
          <button type="submit" class="btn btn-primary btn-sm">Research Companies</button>
        </form>
      <% } else { %>
        <button type="button" class="btn btn-ghost btn-sm" disabled>All companies researched.</button>
      <% } %>
    </div>

    <!-- Deduplication Panel -->
    <div style="background: var(--bg-elevated, #fff); border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 12px; padding: 20px;">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Deduplication</h2>
      <button type="button" class="btn btn-primary btn-sm" id="trigger-dedup-btn">Run Deduplication</button>
      <p id="dedup-status" style="font-size: 12px; color: var(--text-muted, #6B7280); margin-top: 8px;"></p>

      <div id="dedup-groups-container" style="margin-top: 16px;">
        <h3 style="font-size: 13px; font-weight: 500; margin-bottom: 8px;">Duplicate Groups</h3>
        <div id="dedup-groups-list" style="font-size: 12px; color: var(--text-muted, #6B7280);">
          Click "Run Deduplication" or load existing groups below.
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="load-dedup-groups-btn" style="margin-top: 8px;">Load Groups</button>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  'use strict';

  // ── Queue Status Polling ──
  var queuePanel = document.getElementById('queue-status-content');
  var queuePolling = null;

  function pollQueueStatus() {
    fetch('/admin/queue/status')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var html = '';
        if (data.currentTask) {
          html += '<div style="margin-bottom: 4px;"><strong>Current:</strong> ' + escapeHtml(data.currentTask.type || 'unknown') + '</div>';
        } else {
          html += '<div style="margin-bottom: 4px;">Queue idle.</div>';
        }
        if (data.pending && data.pending.length > 0) {
          html += '<div><strong>Pending:</strong> ' + data.pending.length + ' tasks</div>';
        }
        html += '<div style="color: var(--text-muted, #6B7280); margin-top: 4px;">Queue length: ' + (data.queueLength || 0) + '</div>';
        queuePanel.innerHTML = html;

        // Stop polling if idle
        if (!data.currentTask && (!data.pending || data.pending.length === 0)) {
          if (queuePolling) { clearInterval(queuePolling); queuePolling = null; }
        } else if (!queuePolling) {
          queuePolling = setInterval(pollQueueStatus, 5000);
        }
      })
      .catch(function() {
        queuePanel.innerHTML = '<span style="color: #DC2626;">Failed to fetch queue status.</span>';
      });
  }
  pollQueueStatus();

  // ── Platform Selector & Scraper Trigger ──
  var selectedPlatform = 'apsjobs';
  var platformBtns = document.querySelectorAll('.platform-btn');
  var maxPagesContainer = document.getElementById('scraper-max-pages').parentElement;
  var maxPagesInput = document.getElementById('scraper-max-pages');
  var maxPagesNote = document.createElement('div');
  maxPagesNote.style.cssText = 'font-size: 11px; color: var(--text-muted, #6B7280); margin-top: 2px;';
  maxPagesNote.textContent = 'ACT Gov fetches all listings automatically';
  maxPagesNote.style.display = 'none';
  maxPagesContainer.appendChild(maxPagesNote);

  platformBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      platformBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      selectedPlatform = btn.getAttribute('data-platform');

      // Suppress maxPages for actgov
      if (selectedPlatform === 'actgov') {
        maxPagesInput.disabled = true;
        maxPagesInput.style.opacity = '0.5';
        maxPagesNote.style.display = 'block';
      } else {
        maxPagesInput.disabled = false;
        maxPagesInput.style.opacity = '1';
        maxPagesNote.style.display = 'none';
      }
    });
  });

  var triggerBtn = document.getElementById('trigger-scraper-btn');
  var scraperStatus = document.getElementById('scraper-status');
  var scraperSection = document.getElementById('scraper-section');
  if (triggerBtn) {
    triggerBtn.addEventListener('click', function() {
      triggerBtn.disabled = true;
      scraperStatus.textContent = scraperSection.getAttribute('data-i18n-triggering') || 'Triggering scrape, please wait...';

      var body = {
        name: selectedPlatform,
        keywords: document.getElementById('scraper-keywords').value || '',
        location: document.getElementById('scraper-region').value || '',
      };
      if (selectedPlatform !== 'actgov') {
        body.maxPages = parseInt(maxPagesInput.value, 10) || 3;
      }

      fetch('/admin/scraper/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
      .then(function(result) {
        triggerBtn.disabled = false;
        if (result.ok && result.data.success) {
          var runId = result.data.run && result.data.run.id;
          scraperStatus.textContent = runId
            ? (scraperSection.getAttribute('data-i18n-started-with-id') || 'Scrape started, run ID: {runId}.').replace('{runId}', runId)
            : scraperSection.getAttribute('data-i18n-started') || 'Scrape started.';
          if (!queuePolling) { queuePolling = setInterval(pollQueueStatus, 5000); }
        } else {
          scraperStatus.textContent = (scraperSection.getAttribute('data-i18n-trigger-failed-prefix') || 'Trigger failed: ') + (result.data.error && result.data.error.message || 'Unknown error');
        }
      })
      .catch(function() {
        triggerBtn.disabled = false;
        scraperStatus.textContent = scraperSection.getAttribute('data-i18n-network-error') || 'Trigger failed: Network error or server unavailable.';
      });
    });
  }

  // "Scrape All Sources" button — fires one trigger per platform sequentially.
  var triggerAllBtn = document.getElementById('trigger-all-scrapers-btn');
  if (triggerAllBtn) {
    var ALL_PLATFORMS = ['apsjobs', 'actgov', 'nswgov', 'seek', 'linkedin'];
    triggerAllBtn.addEventListener('click', function() {
      triggerAllBtn.disabled = true;
      if (triggerBtn) triggerBtn.disabled = true;
      var keywords = document.getElementById('scraper-keywords').value || '';
      var location = document.getElementById('scraper-region').value || '';
      var maxPages = parseInt(maxPagesInput.value, 10) || 3;

      var results = { ok: [], fail: [] };
      scraperStatus.textContent = 'Triggering all sources...';

      var chain = Promise.resolve();
      ALL_PLATFORMS.forEach(function(platform) {
        chain = chain.then(function() {
          var body = { name: platform, keywords: keywords, location: location };
          if (platform !== 'actgov') body.maxPages = maxPages;
          return fetch('/admin/scraper/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          })
          .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data, platform: platform }; }); })
          .then(function(r) {
            if (r.ok && r.data.success) {
              results.ok.push(platform);
            } else {
              results.fail.push(platform + ' (' + (r.data.error && r.data.error.message || 'unknown') + ')');
            }
          })
          .catch(function() {
            results.fail.push(platform + ' (network error)');
          });
        });
      });

      chain.then(function() {
        triggerAllBtn.disabled = false;
        if (triggerBtn) triggerBtn.disabled = false;
        var parts = [];
        if (results.ok.length) parts.push('Started: ' + results.ok.join(', '));
        if (results.fail.length) parts.push('Failed: ' + results.fail.join(', '));
        scraperStatus.textContent = parts.join(' | ') || 'No scrapers triggered.';
        if (!queuePolling) { queuePolling = setInterval(pollQueueStatus, 5000); }
      });
    });
  }

  // ── Analysis Runs History ──
  var analysisRunsTbody = document.getElementById('analysis-runs-tbody');
  function loadAnalysisRuns() {
    fetch('/admin/analysis/runs')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var runs = data.runs || [];
        if (runs.length === 0) {
          analysisRunsTbody.innerHTML = '<tr><td colspan="7" style="color: var(--text-muted, #6B7280);">No analysis runs yet.</td></tr>';
          return;
        }
        var html = '';
        runs.forEach(function(run) {
          var statusColor = run.status === 'running' ? '#D97706' : (run.status === 'completed' ? '#059669' : '#DC2626');
          html += '<tr>';
          html += '<td>' + run.id + '</td>';
          html += '<td>' + escapeHtml(run.type || run.analysis_type || '-') + '</td>';
          html += '<td><span style="color: ' + statusColor + '; font-weight: 500;">' + escapeHtml(run.status || '-') + '</span></td>';
          html += '<td>' + escapeHtml(run.started_at || run.created_at || '-') + '</td>';
          html += '<td>' + escapeHtml(run.finished_at || '-') + '</td>';
          html += '<td>' + (typeof run.jobs_processed === 'number' ? run.jobs_processed : '-') + '</td>';
          html += '<td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis;">' + escapeHtml(run.error_message || run.error || '-') + '</td>';
          html += '</tr>';
        });
        analysisRunsTbody.innerHTML = html;
      })
      .catch(function() {
        analysisRunsTbody.innerHTML = '<tr><td colspan="7" style="color: #DC2626;">Failed to load analysis runs.</td></tr>';
      });
  }
  loadAnalysisRuns();
  var refreshAnalysisBtn = document.getElementById('refresh-analysis-runs-btn');
  if (refreshAnalysisBtn) refreshAnalysisBtn.addEventListener('click', loadAnalysisRuns);

  // ── Error Log Viewer ──
  var errorLogContainer = document.getElementById('error-log-container');
  function loadErrors() {
    fetch('/admin/errors?limit=50')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var errors = data.errors || [];
        if (errors.length === 0) {
          errorLogContainer.innerHTML = '<p style="font-size: 12px; color: var(--text-muted, #6B7280);">No errors recorded.</p>';
          return;
        }
        var html = '';
        errors.forEach(function(err, idx) {
          html += '<div class="error-log-entry" style="padding: 8px 0; border-bottom: 1px solid var(--border-subtle, #E2E6EA); cursor: pointer;" data-idx="' + idx + '">';
          html += '<div style="display: flex; justify-content: space-between; align-items: center;">';
          html += '<span style="font-size: 12px; color: ' + (err.level === 'error' ? '#DC2626' : '#D97706') + '; font-weight: 500;">[' + (err.level || 'error').toUpperCase() + ']</span>';
          html += '<span style="font-size: 11px; color: var(--text-muted, #6B7280);">' + escapeHtml(err.timestamp || '') + '</span>';
          html += '</div>';
          html += '<div style="font-size: 12px; color: var(--text, #1A1D23); margin-top: 2px;">' + escapeHtml(err.message || '') + '</div>';
          if (err.context) {
            html += '<div style="font-size: 11px; color: var(--text-muted, #6B7280); margin-top: 2px;">' + escapeHtml(err.context.method || '') + ' ' + escapeHtml(err.context.path || '') + '</div>';
          }
          html += '<div class="error-stack" style="display: none; margin-top: 4px; padding: 8px; background: var(--bg-subtle, #F1F3F5); border-radius: 4px; font-family: monospace; font-size: 11px; white-space: pre-wrap; word-break: break-all; color: var(--text-secondary, #4B5563);">' + escapeHtml(err.stack || '') + '</div>';
          html += '</div>';
        });
        if (data.total) html += '<div style="font-size: 11px; color: var(--text-muted, #6B7280); margin-top: 8px;">Showing ' + errors.length + ' of ' + data.total + ' errors</div>';
        errorLogContainer.innerHTML = html;

        // Toggle stack traces
        errorLogContainer.querySelectorAll('.error-log-entry').forEach(function(entry) {
          entry.addEventListener('click', function() {
            var stack = entry.querySelector('.error-stack');
            if (stack) stack.style.display = stack.style.display === 'none' ? 'block' : 'none';
          });
        });
      })
      .catch(function() {
        errorLogContainer.innerHTML = '<p style="color: #DC2626; font-size: 12px;">Failed to load errors.</p>';
      });
  }
  loadErrors();
  var refreshErrorsBtn = document.getElementById('refresh-errors-btn');
  if (refreshErrorsBtn) refreshErrorsBtn.addEventListener('click', loadErrors);

  // ── Cleanup Controls ──
  document.querySelectorAll('.cleanup-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var type = btn.getAttribute('data-type');
      if (!confirm('Run cleanup: ' + type + '? This cannot be undone.')) return;
      btn.disabled = true;
      fetch('/admin/cleanup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: type })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        btn.disabled = false;
        var status = document.getElementById('cleanup-status');
        var parts = [];
        if (typeof data.raw_json_cleared === 'number') parts.push('Raw JSON: ' + data.raw_json_cleared);
        if (typeof data.archived_jobs === 'number') parts.push('Archived: ' + data.archived_jobs);
        if (typeof data.sessions_cleaned === 'number') parts.push('Sessions: ' + data.sessions_cleaned);
        status.textContent = parts.length > 0 ? parts.join(' | ') : 'Cleanup completed.';
      })
      .catch(function() {
        btn.disabled = false;
        document.getElementById('cleanup-status').textContent = 'Cleanup failed.';
      });
    });
  });

  // ── Dedup Controls ──
  var dedupBtn = document.getElementById('trigger-dedup-btn');
  var dedupStatus = document.getElementById('dedup-status');
  if (dedupBtn) {
    dedupBtn.addEventListener('click', function() {
      dedupBtn.disabled = true;
      dedupStatus.textContent = 'Running deduplication...';
      fetch('/admin/dedup/run', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          dedupBtn.disabled = false;
          dedupStatus.textContent = data.status === 'queued' ? 'Queued. Processing ' + (data.job_count || '') + ' jobs.' : 'Dedup triggered.';
          if (!queuePolling) { queuePolling = setInterval(pollQueueStatus, 5000); }
        })
        .catch(function() {
          dedupBtn.disabled = false;
          dedupStatus.textContent = 'Failed to trigger dedup.';
        });
    });
  }

  // Load dedup groups
  var loadDedupBtn = document.getElementById('load-dedup-groups-btn');
  var dedupGroupsList = document.getElementById('dedup-groups-list');
  if (loadDedupBtn) {
    loadDedupBtn.addEventListener('click', function() {
      fetch('/admin/dedup/groups')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var groups = data.groups || [];
          if (groups.length === 0) {
            dedupGroupsList.innerHTML = '<p style="color: var(--text-muted, #6B7280);">No duplicate groups found.</p>';
            return;
          }
          var html = '';
          groups.forEach(function(g) {
            html += '<div style="padding: 8px; border: 1px solid var(--border-subtle, #E2E6EA); border-radius: 8px; margin-bottom: 8px;">';
            html += '<div style="font-size: 12px; margin-bottom: 4px;"><strong>Group #' + g.id + '</strong> (' + escapeHtml(g.match_method || '') + ', confidence: ' + (g.confidence || 0).toFixed(2) + ')</div>';
            (g.members || []).forEach(function(m) {
              html += '<div style="font-size: 11px; color: var(--text-secondary, #4B5563); padding-left: 12px;">Job #' + m.job_id + ' [' + escapeHtml(m.source || '') + '] ' + escapeHtml(m.title || '') + '</div>';
            });
            html += '<div style="margin-top: 6px; display: flex; gap: 4px;">';
            html += '<button type="button" class="btn btn-ghost btn-sm dedup-resolve-btn" data-group-id="' + g.id + '" data-canonical="' + g.canonical_job_id + '" data-action="merge" style="font-size: 11px;">Merge</button>';
            html += '<button type="button" class="btn btn-ghost btn-sm dedup-resolve-btn" data-group-id="' + g.id + '" data-canonical="' + g.canonical_job_id + '" data-action="split" style="font-size: 11px;">Split</button>';
            html += '</div></div>';
          });
          dedupGroupsList.innerHTML = html;

          // Bind resolve buttons
          dedupGroupsList.querySelectorAll('.dedup-resolve-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              fetch('/admin/dedup/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  group_id: Number(btn.getAttribute('data-group-id')),
                  canonical_job_id: Number(btn.getAttribute('data-canonical')),
                  action: btn.getAttribute('data-action')
                })
              })
              .then(function(res) { return res.json(); })
              .then(function(data) {
                if (data.resolved) {
                  btn.closest('[style*="padding: 8px"]').remove();
                  if (window.Toast) window.Toast.show('Group resolved.', 'success');
                }
              })
              .catch(function() {
                if (window.Toast) window.Toast.show('Failed to resolve group.', 'error');
              });
            });
          });
        })
        .catch(function() {
          dedupGroupsList.innerHTML = '<p style="color: #DC2626;">Failed to load groups.</p>';
        });
    });
  }

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }
})();
</script>
<% } %>
