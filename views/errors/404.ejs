<% layout('layout') -%>

<section class="error-page">
  <div class="error-card glass-card">
    <h1 class="error-code">404</h1>
    <h2 class="error-title">
      <%= typeof t === 'function' ? t('errors.404.title', 'Page Not Found') : 'Page Not Found' %>
    </h2>
    <p class="error-body text-secondary">
      <%= typeof message !== 'undefined' && message ? message : (typeof t === 'function' ? t('errors.404.body', "The page you're looking for doesn't exist or has been moved.") : "The page you're looking for doesn't exist or has been moved.") %>
    </p>
    <a href="/jobs" class="btn btn-primary">
      <%= typeof t === 'function' ? t('errors.backToJobs', 'Back to Job Listings') : 'Back to Job Listings' %>
    </a>
  </div>
</section>
