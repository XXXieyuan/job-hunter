<%
  /**
   * SkeletonLoader - Card variant
   * Matches JobCard layout geometry for loading states
   */
%>
<div class="skeleton-card" aria-hidden="true" role="presentation">
  <div style="display: flex; justify-content: space-between; gap: 12px; align-items: flex-start;">
    <div style="flex: 1;">
      <div class="skeleton skeleton-title" style="width: 65%;"></div>
      <div class="skeleton skeleton-text" style="width: 50%;"></div>
    </div>
    <div class="skeleton skeleton-circle" style="width: 48px; height: 48px; flex-shrink: 0;"></div>
  </div>
  <div style="margin-top: 12px;">
    <div class="skeleton skeleton-text" style="width: 100%;"></div>
    <div class="skeleton skeleton-text--short" style="width: 80%;"></div>
  </div>
  <div style="display: flex; gap: 8px; margin-top: 12px;">
    <div class="skeleton" style="width: 80px; height: 24px; border-radius: 6px;"></div>
    <div class="skeleton" style="width: 60px; height: 24px; border-radius: 6px;"></div>
    <div class="skeleton" style="width: 100px; height: 24px; border-radius: 6px;"></div>
  </div>
</div>
